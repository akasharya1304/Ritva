generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Book {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  author    String
  category  String
  pdfUrl    String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ritva {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model YogaContent {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  slug              String         @unique // e.g., "introduction-to-yoga"
  title_en          String
  title_hi          String?        
  category          String         // e.g., "Philosophy", "History"
  thumbnailUrl      String?        
  estimatedReadTime Int            
  order             Int            // To keep chapters in sequence
  
  // This is the array of blocks (Paragraphs, Quotes, Images)
  sections          ContentBlock[] 
  
  createdAt         DateTime?      @default(now())
  updatedAt         DateTime?      @updatedAt
}

// Using a type (Embedded Document) for the content parts
type ContentBlock {
  type       String   // "heading", "paragraph", "quote", "image", "list"
  content_en String   
  content_hi String?  
  author     String?  // Specifically for quotes
  imageUrl   String?  // Specifically for image blocks
  caption_en String?  
  caption_hi String?
}

model YogaPose {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  category  String          // Asana / Pranayama/ Mudra / Bandha / Shatkanna
  asanaName String          // Padanguli Naman (toe bending)
  group     String          // Pawanmuktasana Part 1 ANTI-RHEUMATIC GROUP
  type      String          // Beginner
  details   YogaPoseDetails
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

type YogaPoseDetails {
  pic               String[]
  steps             String[]
  stage             YogaPoseStage[]
  breathing         String?
  awareness         String?
  benefits          String?
  contraindications String?
  practiceNote      String?
  variation         String?
  sequence          String?
  duration          String?
}

type YogaPoseStage {
  index       Int
  description String
}

model AsanaContent {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  summary   String
  details   AsanaContentDetail[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

type AsanaContentDetail {
  heading     String
  description String
}
